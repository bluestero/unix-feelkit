#!/usr/bin/env bash
# fk: feelkit's front door. `fk help` lists the commands.
set -uo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# the toolkit's folder: walk up from here (works inside the toolkit and as a layer in layers/)
repo=$(cd "$(dirname "$SELF")/.." && pwd); until [[ -f $repo/lib/setup.sh || $repo == / ]]; do repo=$(dirname "$repo"); done
mode=ask details=0
# shellcheck source=../../../lib/setup.sh
. "$repo/lib/setup.sh"
# shellcheck source=../../../lib/components.sh
. "$repo/lib/components.sh"
# shellcheck source=../../../lib/inplace.sh
. "$repo/lib/inplace.sh"
ask() { confirm "$@"; }   # a picker, not a typed y/N (lib/ui.sh)

# id|name shown|uuid|dconf path|preset|name the originals are kept under|ignore regex
# (the regex last: it can hold |, and read gives the last name the rest of the line)
looks_table() {
  printf '%s\n' \
    "vitals|Vitals|$vt_uuid|$vt_path|$vt_file|$vt_uuid|" \
    "blur-my-shell|Blur my Shell|$bm_uuid|$bm_path|$bm_file|$bm_uuid|" \
    "rounded-corners|Rounded Window Corners|$rc_uuid|$rc_path|$rc_file|$rc_uuid|" \
    "dash-to-panel|Dash to Panel|$dtp_uuid|$dtp_path|$dtp_src/settings.dconf|dash-to-panel|$dtp_ignore"
}

# What each extension does (the list's last column).
looks_about() {
  case $1 in
    vitals)          echo "CPU, memory and network readings in the top bar" ;;
    blur-my-shell)   echo "blurs the top bar, the overview and the dock" ;;
    rounded-corners) echo "rounded corners on every window" ;;
    dash-to-panel)   echo "a taskbar in place of the top bar and the dock" ;;
  esac
}
# What each choice does (the choices' second column).
looks_note() {
  case $1 in
    "$LOOK_KEEP") echo "nothing changes" ;;
    "$LOOK_APP")  echo "feelkit's preset for these settings" ;;
    "$LOOK_RST")  echo "asks first; undo brings them back" ;;
    "$LOOK_PRE")  echo "what you had before feelkit set them" ;;
    "$LOOK_UND")  echo "one step back" ;;
  esac
}

# The extensions that are installed and enabled, one id per line.
looks_ids() {
  local id nice uuid path file name ign
  while IFS='|' read -r id nice uuid path file name ign; do
    gx_present "$uuid" && gx_enabled "$uuid" && echo "$id"
  done < <(looks_table)
}
looks_row() { looks_table | grep "^$1|"; }   # the table row of an id

# The list's cells (laid out by looks_lay): a title row, then name · look · what it does, the id after a TAB.
looks_rows() {
  local id nice uuid path file name ign look S=$'\x1f'
  {
    printf 'EXTENSION%sLOOK%sWHAT IT DOES\n' "$S" "$S"
    for id in $(looks_ids); do
      IFS='|' read -r id nice uuid path file name ign <<<"$(looks_row "$id")"
      if look_applied "$path" "$file" "$ign"; then look="${C_GREEN}✓${C_RESET} toolkit look"; else look="your own settings"; fi
      printf '%s\t%s\n' "$nice$S$look$S$(looks_about "$id")" "$id"
    done
  }
}
# An extension's choices' cells: a title row, then choice · what it does, the choice after a TAB.
looks_menu_rows() {   # name
  local c S=$'\x1f'
  printf 'CHOICE%sWHAT IT DOES\n' "$S"
  look_choices "$1" | while IFS= read -r c; do printf '%s\t%s\n' "$c$S$(looks_note "$c")" "$c"; done
}
# Lay out the kept cells (list or menu) for the width fzf has now: rows.<which>.
looks_lay() { print_table 3 "$(ui_pick_width)" <"$IP/cells.$1" >"$IP/rows.$1"; }
LOOKS_KEYS="# Pick an extension, then what to do with its settings
enter: choose · esc: close"

cmd_looks() {   # fk looks [id]: re-apply, reset, put back or undo an extension's settings
  local want=${1:-} row id nice uuid path file ign name
  if [[ -n $want ]]; then   # no list to stay in: the small box
    row=$(looks_row "$want") || ui_unknown fk "$want" extension
    IFS='|' read -r id nice uuid path file name ign <<<"$row"
    gx_present "$uuid" && gx_enabled "$uuid" || die "$nice isn't installed and enabled · see: fk install ls"
    look_menu "$path" "$file" "$name" "$nice" "$ign"; return
  fi
  [[ -n $(looks_ids) ]] || die "no feelkit extension to adjust · see: fk install ls"
  if ! ui_fzf_at_least 0.63; then die "the list needs fzf 0.63 or newer · or: fk looks <extension>"; fi
  # One list that stays open: enter on an extension shows its choices in the same list
  # (the reset question in its header); results go in the footer (lib/inplace.sh).
  IP=$(mktemp -d) || return 1; export IP
  trap 'rm -rf "$IP"' EXIT
  ip_set mode list
  looks_rows >"$IP/cells.list"; looks_lay list
  local cb k; cb="$(printf %q "$SELF") __key"
  local -a binds=(--bind "start:unbind(y,n)")
  for k in enter esc y n resize; do binds+=(--bind "$k:transform:$cb $k {2} {q}"); done
  ui_fzf 'fk · looks' --toast --with-shell='bash -c' --delimiter='\t' --with-nth=1 --header-lines=1 \
    --prompt='extension> ' --footer=' ' --header="$LOOKS_KEYS" "${binds[@]}" <"$IP/rows.list" >/dev/null
  return 0   # esc is the way out (fzf's 130), not an error: okcli, kx and ws exit 0 too
}

# Back to the extensions: rows, header, a result in the footer.
looks_to_list() {   # [toast]
  [[ -n ${1:-} ]] && looks_rows >"$IP/cells.list"   # something was done: its look may have changed
  looks_lay list   # (the window may have been resized meanwhile)
  local n; n=$(awk -F'\t' -v id="$(ip_get cur)" '$2 == id { print NR - 1; exit }' "$IP/rows.list")
  local -a a=("$(ip_back)" "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.list")")" "pos(${n:-1})"
    "$(ip_fz change-header "$(ui_keys "$LOOKS_KEYS")")" "$(ip_fz change-prompt 'extension> ')")
  if [[ -n ${1:-} ]]; then a+=("$(ui_toast "$1")"); else a+=("$(ip_fz change-footer " ")"); fi
  ip_join "${a[@]}"
}
looks_toast() {   # look_do's output (✓ ... / – ...) as one footer line
  local t; t=$(strip_ansi "$1" | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ $t == ✓* ]] || t="✗ ${t:-nothing changed}"
  printf '%s' "$t"
}

# The list's keys (a callback has no terminal): prints fzf actions.
looks_key() {   # key value query (value: the id in the list, the choice in the menu)
  local k=$1 id=$2 label=$2 q=$3 m row nice uuid path file ign name out state
  m=$(ip_get mode)
  if [[ $k == resize ]]; then   # the table again for the new width, the cursor on the same row
    local w=list; [[ $m == list ]] || w=menu
    looks_lay "$w"; ip_join "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.$w")")" "pos(${FZF_POS:-1})"; return
  fi
  case $m in
    list)
      case $k in
        esc) echo abort ;;
        enter)
          [[ -n $id ]] || return 0
          row=$(looks_row "$id") && IFS='|' read -r id nice uuid path file name ign <<<"$row" || return 0
          ip_set saved_q "$q"; ip_set mode menu; ip_set cur "$id"
          looks_menu_rows "$name" >"$IP/cells.menu"; looks_lay menu
          if look_applied "$path" "$file" "$ign"; then state="match the toolkit look"; else state="are your own (not the toolkit look)"; fi
          ip_join "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.menu")")" first "$(ip_fz change-query "")" disable-search \
            "$(ip_fz change-header "$(ui_keys "# $nice: its settings $state"$'\n'"enter: do it · esc: back")")" \
            "$(ip_fz change-prompt "$nice> ")" "$(ip_fz change-footer " ")" ;;
      esac ;;
    menu)
      IFS='|' read -r id nice uuid path file name ign <<<"$(looks_row "$(ip_get cur)")"
      case $k in
        esc) looks_to_list ;;
        enter)
          [[ -n $label ]] || return 0
          if [[ $label == "$LOOK_RST" ]]; then
            ip_confirm "Reset $nice to the app's defaults? (the menu can undo it)" reset n; return
          fi
          out=$(look_do "$path" "$file" "$name" "$nice" "$label" 2>&1); looks_to_list "$(looks_toast "$out")" ;;
      esac ;;
    confirm)
      local a; a=$(ip_answer "$k"); [[ -n $a ]] || return 0
      IFS='|' read -r id nice uuid path file name ign <<<"$(looks_row "$(ip_get cur)")"
      if [[ $a == yes ]]; then out=$(look_do "$path" "$file" "$name" "$nice" "$LOOK_RST" 2>&1); looks_to_list "$(looks_toast "$out")"
      else looks_to_list "Nothing changed"; fi ;;
  esac
}

case "${1:-help}" in
  install)   shift; exec "$repo/install.sh" --layer=feelkit "$@" ;;
  uninstall) shift; exec "$repo/uninstall.sh" --layer=feelkit "$@" ;;
  looks) shift; cmd_looks "$@" ;;
  __key) [[ -z ${NO_COLOR:-} ]] && ui_color; looks_key "${2:-}" "${3:-}" "${4:-}" ;;
  doctor) exec bash "$(dirname "$SELF")/../gnome/dash2dock/check-patch.sh" "${@:2}" ;;
  help|-h|--help) ui_help fk "feelkit: the appearance parts" <<'HELP'
## Commands
fk install [part...]	set up feelkit's parts: a tab per group, then one question per change	e.g. fk install kitty-theme · fk install ls lists them
fk uninstall [part...]	remove them, putting your own settings back
fk looks [extension]	re-apply an extension's look, reset it, put your old settings back or undo the last change	Extensions: vitals, blur-my-shell, rounded-corners, dash-to-panel
fk doctor [dir|zip]	try our Dash2Dock patch against the newest release (or a folder/zip), hunk by hunk
fk help	this page
HELP
  ;;
  *) ui_unknown fk "$1" command ;;
esac
