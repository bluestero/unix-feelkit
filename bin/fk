#!/usr/bin/env bash
# fk: feelkit's front door. `fk help` lists the commands.
set -uo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# the toolkit's folder: walk up from here (works inside the toolkit and as a layer in layers/)
repo=$(cd "$(dirname "$SELF")/.." && pwd); until [[ -f $repo/lib/setup.sh || $repo == / ]]; do repo=$(dirname "$repo"); done
mode=ask details=0
# shellcheck source=../../../lib/setup.sh
. "$repo/lib/setup.sh"
# shellcheck source=../../../lib/components.sh
. "$repo/lib/components.sh"
# shellcheck source=../../../lib/inplace.sh
. "$repo/lib/inplace.sh"
ask() { confirm "$@"; }   # a picker, not a typed y/N (lib/ui.sh)

# id|name shown|uuid|dconf path|preset|ignore regex|name the originals are kept under
looks_table() {
  printf '%s\n' \
    "vitals|Vitals|$vt_uuid|$vt_path|$vt_file||$vt_uuid" \
    "blur-my-shell|Blur my Shell|$bm_uuid|$bm_path|$bm_file||$bm_uuid" \
    "rounded-corners|Rounded Window Corners|$rc_uuid|$rc_path|$rc_file||$rc_uuid" \
    "dash-to-panel|Dash to Panel|$dtp_uuid|$dtp_path|$dtp_src/settings.dconf|$dtp_ignore|dash-to-panel"
}

# The extensions that are installed and enabled, as rows: name shown, id.
looks_rows() {
  local id nice uuid path file ign name S=$'\x1f'
  while IFS='|' read -r id nice uuid path file ign name; do
    gx_present "$uuid" && gx_enabled "$uuid" || continue
    printf '%s%s%s\n' "$nice" "$S" "$id"
  done < <(looks_table)
}
looks_row() { looks_table | grep "^$1|"; }   # the table row of an id

cmd_looks() {   # fk looks [id]: re-apply, reset, put back or undo an extension's settings
  local want=${1:-} row id nice uuid path file ign name S=$'\x1f'
  if [[ -n $want ]]; then   # no list to stay in: the small box
    row=$(looks_row "$want") || ui_unknown fk "$want" extension
    IFS='|' read -r id nice uuid path file ign name <<<"$row"
    gx_present "$uuid" && gx_enabled "$uuid" || die "$nice isn't installed and enabled · see: ./install.sh ls"
    look_menu "$path" "$file" "$name" "$nice" "$ign"; return
  fi
  [[ -n $(looks_rows) ]] || die "no feelkit extension to adjust · see: ./install.sh ls"
  if ! ui_fzf_at_least 0.63; then die "the list needs fzf 0.63 or newer · or: fk looks <extension>"; fi
  # One list that stays open: enter on an extension shows its choices in the same list
  # (the reset question in its header); results go in the footer (lib/inplace.sh).
  IP=$(mktemp -d) || return 1; export IP
  trap 'rm -rf "$IP"' EXIT
  ip_set mode list
  looks_rows >"$IP/rows.list"
  local cb k; cb="$(printf %q "$SELF") __key"
  local -a binds=(--bind "start:unbind(y,n)")
  for k in enter esc y n; do binds+=(--bind "$k:transform:$cb $k {1} {2} {q}"); done
  ui_fzf looks --toast --with-shell='bash -c' --delimiter="$S" --with-nth=1 --prompt='  ' --footer=' ' \
    --header='enter: choose · esc: close' "${binds[@]}" <"$IP/rows.list" >/dev/null
  return 0   # esc is the way out (fzf's 130), not an error: okcli, kx and ws exit 0 too
}

# Back to the extensions: rows, header, a result in the footer.
looks_to_list() {   # [toast]
  local n; n=$(awk -F"$(printf '\x1f')" -v id="$(ip_get cur)" '$2 == id { print NR; exit }' "$IP/rows.list")
  local -a a=("$(ip_back)" "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.list")")" "pos(${n:-1})"
    "$(ip_fz change-header "$(ui_keys "enter: choose · esc: close")")" "$(ip_fz change-prompt '  ')")
  if [[ -n ${1:-} ]]; then a+=("$(ui_toast "$1")"); else a+=("$(ip_fz change-footer " ")"); fi
  ip_join "${a[@]}"
}
looks_toast() {   # look_do's output (✓ ... / – ...) as one footer line
  local t; t=$(strip_ansi "$1" | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ $t == ✓* ]] || t="✗ ${t:-nothing changed}"
  printf '%s' "$t"
}

# The list's keys (a callback has no terminal): prints fzf actions.
looks_key() {   # key row-label row-id query
  local k=$1 label=$2 id=$3 q=$4 m row nice uuid path file ign name out state
  m=$(ip_get mode)
  case $m in
    list)
      case $k in
        esc) echo abort ;;
        enter)
          [[ -n $id ]] || return 0
          row=$(looks_row "$id") && IFS='|' read -r id nice uuid path file ign name <<<"$row" || return 0
          ip_set saved_q "$q"; ip_set mode menu; ip_set cur "$id"
          look_choices "$name" >"$IP/rows.menu"
          if look_applied "$path" "$file" "$ign"; then state="match the toolkit look"; else state="differ from the toolkit look"; fi
          ip_join "$(ip_fz reload-sync "cat $(printf %q "$IP/rows.menu")")" first "$(ip_fz change-query "")" disable-search \
            "$(ip_fz change-header "$(ui_keys "$nice settings $state"$'\n'"enter: do it · esc: back")")" \
            "$(ip_fz change-prompt '  ')" "$(ip_fz change-footer " ")" ;;
      esac ;;
    menu)
      IFS='|' read -r id nice uuid path file ign name <<<"$(looks_row "$(ip_get cur)")"
      case $k in
        esc) looks_to_list ;;
        enter)
          [[ -n $label ]] || return 0
          if [[ $label == "$LOOK_RST" ]]; then
            ip_confirm "Reset $nice to the app's defaults? (the menu can undo it)" reset n; return
          fi
          out=$(look_do "$path" "$file" "$name" "$nice" "$label" 2>&1); looks_to_list "$(looks_toast "$out")" ;;
      esac ;;
    confirm)
      local a; a=$(ip_answer "$k"); [[ -n $a ]] || return 0
      IFS='|' read -r id nice uuid path file ign name <<<"$(looks_row "$(ip_get cur)")"
      if [[ $a == yes ]]; then out=$(look_do "$path" "$file" "$name" "$nice" "$LOOK_RST" 2>&1); looks_to_list "$(looks_toast "$out")"
      else looks_to_list "Nothing changed"; fi ;;
  esac
}

case "${1:-help}" in
  looks) shift; cmd_looks "$@" ;;
  __key) [[ -z ${NO_COLOR:-} ]] && ui_color; looks_key "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  doctor) exec bash "$(dirname "$SELF")/../gnome/dash2dock/check-patch.sh" "${@:2}" ;;
  help|-h|--help) ui_help fk "feelkit: the appearance parts" <<'HELP'
## Commands
fk looks [extension]	re-apply an extension's look, reset it, put your old settings back or undo the last change	Extensions: vitals, blur-my-shell, rounded-corners, dash-to-panel
fk doctor [dir|zip]	try our Dash2Dock patch against the newest release (or a folder/zip), hunk by hunk
fk help	this page
HELP
  ;;
  *) ui_unknown fk "$1" command ;;
esac
